//@version=6
indicator(title="Wave Length", shorttitle="Wave Length", overlay=true)

//Expert Trend Locator (XTL)
len     = input.int(34, minval=1, title = "XTL Period")
hLmt    = input.float(34, title="Threshold Value", minval=10)

xtl_src = hlc3
XTL = ta.cci(xtl_src, len)

bull = XTL > hLmt
bear = XTL < -hLmt
neutral = (XTL <= hLmt) and (XTL >= -hLmt)

upcolor = color.rgb(0, 135, 225)
dwncolor = color.rgb(255, 0, 0)
ntlcolor = color.rgb(255, 255, 255, 30)

barcolor(bull ? upcolor : neutral ? ntlcolor : dwncolor)

//Displaced Moving Average (DMA)
showdma = input.bool(true, "Show DMA?")
malength = input.int(8, minval=1, title="DMA Length")
displacement=input.int(5, minval=0, title="DMA Displacement")

DMA1 = ta.sma(low, malength)
DMA2 = ta.sma(high, malength)

DMA_Color = DMA1 > DMA1[1] ? color.rgb(50, 125, 255, 60) : DMA1 <= DMA1[1] ? color.rgb(250, 0, 0, 60) : color.black
ccol = color.rgb(255, 255, 255, 90)
d1 = plot(showdma ? DMA1 : na, title="DMA1", color = DMA_Color, linewidth = 2, offset = displacement)
d2 = plot(showdma ? DMA2 : na, title="DMA2", color = DMA_Color, linewidth = 2, offset = displacement)
fill(d1, d2, color = ccol, title = "DMA Cloud")

///Breakout Bar Entry & Stop
showbbar = input.bool(true, title = "Show Breakout Bar Signals")
cont = input.bool(false, title = "Levels as Lines")

var int state = 0
state := bear ? 0 : bull ? 1 : neutral ? nz(state[1]) : na
prev_state = nz(state[1])

bbar_stop = input.float(0.5, title = "Stop Loss Ratio")
bbar_entry = input.float(1.5, title = "Entry Ratio")

tar1 = input.bool(true, title = "Show Target 1")
tar2 = input.bool(false, title = "Show Target 2")
bbar_tgt1 = input.float(3.0, title = "Target Ratio 1")
bbar_tgt2 = input.float(4.0, title = "Target Ratio 2")

bar_range = high - low

var float cstop = 0
cstop := state > prev_state ? (low - bar_range * bbar_stop) : state < prev_state ? (high + bar_range * bbar_stop) : nz(cstop[1], na)
var float centry = 0
centry := state > prev_state ? (low + bar_range * bbar_entry) : state < prev_state ? (high - bar_range * bbar_entry) : nz(centry[1], na)
var float ctgt1 = 0
ctgt1 := state > prev_state ? (low + bar_range * bbar_tgt1) : state < prev_state ? (high - bar_range * bbar_tgt1) : nz(ctgt1[1], na)
var float ctgt2 = 0
ctgt2 := state > prev_state ? (low + bar_range * bbar_tgt2) : state < prev_state ? (high - bar_range * bbar_tgt2) : nz(ctgt2[1], na)

ncstop = state > prev_state ? (low - bar_range * bbar_stop) : state < prev_state ? (high + bar_range * bbar_stop) : na
ncentry = state > prev_state ? (low + bar_range * bbar_entry) : state < prev_state ? (high - bar_range * bbar_entry) : na
nctgt1 = state > prev_state ? (low + bar_range * bbar_tgt1) : state < prev_state ? (high - bar_range * bbar_tgt1) : na
nctgt2 = state > prev_state ? (low + bar_range * bbar_tgt2) : state < prev_state ? (high - bar_range * bbar_tgt2) : na

pstop = cont ? cstop : ncstop
pentry = cont ? centry : ncentry
ptgt1 = cont ? ctgt1 : nctgt1
ptgt2 = cont ? ctgt2 : nctgt2
displ = cont ? -1 : 0

var int colbar = 1
colbar := bull ? 1 : bear ? 0 : nz(colbar[1], na)
color entrycol = colbar == 1 ? color.rgb(0,0,255) : color.rgb(255,0,0)
color stopcol = colbar == 1 ? color.rgb(255,0,0) : color.rgb(0,0,255)

plot(showbbar ? (ta.change(pstop) ? na : pstop) : na, title='Stop', color=stopcol, linewidth=2, style=plot.style_circles, offset= displ)
plot(showbbar ? (ta.change(pentry) ? na : pentry) : na, title='Entry Signal', color=entrycol, linewidth=2, style=plot.style_linebr, offset= displ)
plot((showbbar and tar1) ? (ta.change(ptgt1) ? na : ptgt1) : na, title='Target 1', color=color.yellow, linewidth=2, style=plot.style_cross, offset = displ)
plot((showbbar and tar2) ? (ta.change(ptgt2) ? na : ptgt2) : na, title='Target 2', color=color.yellow, linewidth=2, style=plot.style_cross, offset = displ)

// === Script 2 Logic (Weekly ADX Breakout) ===
adxLen = input.int(14, title="ADX/DMI Length")
adxCompression = input.float(10.0, title="ADX Compression Level")

// Function to compute ADX signal
f_adx_weekly_signal(length, compression) =>
    [diPlus, diMinus, adx] = ta.dmi(length, length)
    adxWasCompressed = adx[1] < compression
    adxTurningUp = adx > adx[1]
    diCrossover = ta.crossover(diPlus, diMinus)
    diSlopingUp = diPlus > diPlus[1]

    adxWasCompressed and adxTurningUp and diCrossover and diSlopingUp

// Use request.security for Weekly timeframe regardless of chart timeframe
weeklySignal = request.security(syminfo.tickerid, "W", f_adx_weekly_signal(adxLen, adxCompression))

plotshape(weeklySignal, title="Bullish Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
