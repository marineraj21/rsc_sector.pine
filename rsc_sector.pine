    sectorMap.put('NSE:NBCC', 'NSE:CNXREALTY')
    sectorMap.put('NSE:OBEROIRLTY', 'NSE:CNXREALTY')
    sectorMap.put('NSE:PHOENIXLTD', 'NSE:CNXREALTY')
