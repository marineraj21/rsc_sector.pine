        array.push(a0, rs0_3), array.push(a1, rs1_3), array.push(a2, rs2_3), array.push(aP, pct3)
        array.push(aC, c_3), array.push(aLine, v_3)
    if on4
        array.push(aId, id4), array.push(aNm, nm4), array.push(aS, 4), array.push(aW, array.get(wts, 3))
        array.push(a0, rs0_4), array.push(a1, rs1_4), array.push(a2, rs2_4), array.push(aP, pct4)
        array.push(aC, c_4), array.push(aLine, v_4)
