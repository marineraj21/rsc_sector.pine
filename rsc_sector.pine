        array.push(aId, id7), array.push(aNm, nm7), array.push(aS, 7), array.push(aW, array.get(wts, 6))
        array.push(a0, rs0_7), array.push(a1, rs1_7), array.push(a2, rs2_7), array.push(aP, pct7)
