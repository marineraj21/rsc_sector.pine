    if on9
        array.push(aId, id9), array.push(aNm, nm9), array.push(aS, 9), array.push(aW, array.get(wts, 8))
        array.push(a0, rs0_9), array.push(a1, rs1_9), array.push(a2, rs2_9), array.push(aP, pct9)
