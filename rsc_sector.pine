        array.push(aId, id8), array.push(aNm, nm8), array.push(aS, 8), array.push(aW, array.get(wts, 7))
        array.push(a0, rs0_8), array.push(a1, rs1_8), array.push(a2, rs2_8), array.push(aP, pct8)
