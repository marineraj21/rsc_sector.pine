txtSize = tblSize == 'Tiny' ? size.tiny : tblSize == 'Normal' ? size.normal : size.small
pos = tblPos == 'Top Left' ? position.top_left : tblPos == 'Bottom Right' ? position.bottom_right : tblPos == 'Middle Right' ? position.middle_right : position.top_right

fstr(float v) =>
    na(v) ? '-' : str.tostring(v, '#0.00')

wstr(float v) =>
    na(v) ? '-' : str.tostring(v, '#0.00') + '%'

textOn(color bg) =>
    float lum = na(bg) ? 0.0 : 0.299 * color.r(bg) + 0.587 * color.g(bg) + 0.114 * color.b(bg)
    lum > 140 ? color.black : color.white

rsShade(float v, float o1, float o2) =>
    color res = colBlank
    if not na(v)
        int gt = 0
        if not na(o1) and o1 > v
            gt += 1
        if not na(o2) and o2 > v
            gt += 1
        res := gt == 0 ? colRsHi : gt == 1 ? colRsMid : colRsLo
    res

