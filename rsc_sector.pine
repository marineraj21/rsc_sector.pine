                    if j + 1 < s_n
                        if nz(array.get(currentVals, j)) < nz(array.get(currentVals, j + 1))
                            float temp_v = array.get(currentVals, j)
                            array.set(currentVals, j, array.get(currentVals, j + 1))
                            array.set(currentVals, j + 1, temp_v)

                            int temp_s = array.get(originalSlots, j)
                            array.set(originalSlots, j, array.get(originalSlots, j + 1))
                            array.set(originalSlots, j + 1, temp_s)

        if hlTarget <= s_n
