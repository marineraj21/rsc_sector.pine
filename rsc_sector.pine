        array.push(aId, id6), array.push(aNm, nm6), array.push(aS, 6), array.push(aW, array.get(wts, 5))
        array.push(a0, rs0_6), array.push(a1, rs1_6), array.push(a2, rs2_6), array.push(aP, pct6)
