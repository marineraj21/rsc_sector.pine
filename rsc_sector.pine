    sectorMap.put('NSE:INDUSTOWER', 'NSE:CNXSERVICE')
    sectorMap.put('NSE:NAUKRI', 'NSE:CNXSERVICE')
    sectorMap.put('NSE:NYKAA', 'NSE:CNXSERVICE')
    sectorMap.put('NSE:PAYTM', 'NSE:CNXSERVICE')
    sectorMap.put('NSE:SWIGGY', 'NSE:CNXSERVICE')

// Resolve sector with TV ticker variants (M&M/M_M, BAJAJ-AUTO/BAJAJ_AUTO, etc.)
string compID = sectorMap.get(syminfo.tickerid)
if na(compID)
    compID := sectorMap.get(str.replace_all(syminfo.tickerid, '_', '-'))
if na(compID)
    compID := sectorMap.get(str.replace_all(syminfo.tickerid, '-', '_'))
if na(compID)
    compID := sectorMap.get(str.replace_all(syminfo.tickerid, '&', '_'))
if na(compID)
    compID := 'NSE:CNX500'

string benchmark = switch defaultBType
    'NIFTY50' => 'NSE:NIFTY'
    'Custom Benchmark' => defaultBID
    => compID

securityPrice = source
comparativePrice = request.security(benchmark, timeframe.period, source, barmerge.gaps_off, barmerge.lookahead_off, ignore_invalid_symbol=true)

// Anchored RS Logic Fix
var float anchorStockPrice = na
var float anchorBenchPrice = na

bool isAnchorBar = time >= historyDate and time[1] < historyDate

if flagARS
    if isAnchorBar
        anchorStockPrice := securityPrice
        anchorBenchPrice := comparativePrice
else
    anchorStockPrice := securityPrice[len]
    anchorBenchPrice := comparativePrice[len]

float ratioStock = securityPrice / anchorStockPrice
float ratioBench = comparativePrice / anchorBenchPrice

float RS = ratioBench == 0 or na(ratioBench) or na(ratioStock) ? na : (ratioStock / ratioBench - 1.0) * 100.0
float MA = ta.sma(RS, lenMA)

// Render RS...
color colorRS = flagRSColor ? (RS >= MA ? colorRSPos : colorRSNeg) : colorRSZero
plotRS = plot(RS, title='RS', linewidth=2, color=colorRS)

// Render MA...
plotMA = plot(flagMA ? MA : na, title='MA', linewidth=2, color=colorMALine, display=display.all - display.status_line)

// Render Zero Line...
float angleRS = zrTrendLookBack == 0 or na(RS) ? 0.0 : math.atan((RS - RS[zrTrendLookBack]) / zrTrendLookBack)
color colorZR = flagZRTrend ? (angleRS > 0 ? colorRSPos : angleRS < 0 ? colorRSNeg : colorZeroLine) : colorZeroLine
plotZR = plot(0, title='Zero Line', linewidth=1, color=colorZR, display=display.all - display.status_line)

// Divergence Dots...
bool rsRising = ta.rising(RS, divLookBack)
bool priceFalling = ta.falling(securityPrice, divLookBack)
bool rsFalling = ta.falling(RS, divLookBack)
bool priceRising = ta.rising(securityPrice, divLookBack)
color colorDiv = flagDivDots ? ((rsRising and priceFalling) ? colorDivPos : (rsFalling and priceRising) ? colorDivNeg : na) : na
plot(flagDivDots ? RS : na, 'Divergence Dots', color=colorDiv, linewidth=3, style=plot.style_circles, display=display.all - display.status_line)

// Fill Area...
int xTPPos = RS >= MA ? 70 : 85
int xTPNeg = RS < MA ? 70 : 85
color colorFill = RS >= 0 ? color.new(colorRSPos, xTPPos) : color.new(colorRSNeg, xTPNeg)
fill(plotRS, plotZR, color=flagFill ? colorFill : na)

var sectorTable = table.new(position=position.bottom_center, columns=1, rows=1, border_width=1)
if barstate.islast and flagSectorName
    table.cell(table_id=sectorTable, column=0, row=0, text=str.tostring(compID), text_size=size.small, text_color=colorText)

// Divergence...
flagDivRegular = input.bool(defval=true, title='Display Regular Divergence Lines', group='Divergence')
flagDivHidden = input.bool(defval=false, title='Display Hidden Divergence Lines', group='Divergence')
lbL = input.int(defval=5, minval=1, title='Pivot Lookback Left', group='Divergence', display=display.none)
lbR = input.int(defval=5, minval=1, title='Pivot Lookback Right', group='Divergence', display=display.none)
rangeLower = input.int(defval=5, minval=1, title='Minimum Lookback Range', group='Divergence', display=display.none)
rangeUpper = input.int(defval=60, minval=1, title='Maximum Lookback Range', group='Divergence', display=display.none)

regularBullColor = color.new(color.green, 30)
hiddenBullColor = color.new(color.green, 60)
regularBearColor = color.new(color.red, 30)
hiddenBearColor = color.new(color.red, 60)
noneColor = color.new(color.white, 100)

isInRange(bool cond) =>
    bars = ta.barssince(cond)
    rangeLower <= bars and bars <= rangeUpper

float oscLBR = RS[lbR]

float pivotLow = ta.pivotlow(RS, lbL, lbR)
float pivotHigh = ta.pivothigh(RS, lbL, lbR)
bool plFound = not na(pivotLow)
bool phFound = not na(pivotHigh)

float oscLBRPlVal = ta.valuewhen(plFound, oscLBR, 1)
float oscLBRPhVal = ta.valuewhen(phFound, oscLBR, 1)
float lowLbRPlVal = ta.valuewhen(plFound, low[lbR], 1)
float highLbRPhVal = ta.valuewhen(phFound, high[lbR], 1)

bool plRange = isInRange(plFound[1])
bool phRange = isInRange(phFound[1])

bool oscHL = oscLBR > oscLBRPlVal and plRange
bool oscLL = oscLBR < oscLBRPlVal and plRange
bool oscLH = oscLBR < oscLBRPhVal and phRange
bool oscHH = oscLBR > oscLBRPhVal and phRange

bool priceLL = low[lbR] < lowLbRPlVal
bool priceHL = low[lbR] > lowLbRPlVal
bool priceHH = high[lbR] > highLbRPhVal
bool priceLH = high[lbR] < highLbRPhVal

bool regularBullDiv = flagDivRegular and priceLL and oscHL and plFound
bool hiddenBullDiv = flagDivHidden and priceHL and oscLL and plFound
bool regularBearDiv = flagDivRegular and priceHH and oscLH and phFound
bool hiddenBearDiv = flagDivHidden and priceLH and oscHH and phFound

plot(plFound and (flagDivRegular or flagDivHidden) ? oscLBR : na, offset=-lbR, title='Regular Bullish', linewidth=1, color=regularBullDiv ? regularBullColor : noneColor, display=display.all - display.status_line)
plot(phFound and (flagDivRegular or flagDivHidden) ? oscLBR : na, offset=-lbR, title='Regular Bearish', linewidth=1, color=regularBearDiv ? regularBearColor : noneColor, display=display.all - display.status_line)
plot(plFound and (flagDivRegular or flagDivHidden) ? oscLBR : na, offset=-lbR, title='Hidden Bullish', linewidth=1, color=hiddenBullDiv ? hiddenBullColor : noneColor, display=display.all - display.status_line)
plot(phFound and (flagDivRegular or flagDivHidden) ? oscLBR : na, offset=-lbR, title='Hidden Bearish', linewidth=1, color=hiddenBearDiv ? hiddenBearColor : noneColor, display=display.all - display.status_line)
