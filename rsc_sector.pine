//@version=6
indicator(title='RSC-SECTOR', shorttitle='RSC', overlay=false, precision=2)
// Enhanced version of 'Relative Strength' indicator of BharatTrader Sir...
// Default values for some of the parameters are based on discussion by Subhadip Nandy Sir in Trader's Talk with Mr. Rohit Katwal...
// Allows to display Anchored RS based on selection of specific date...

// Get inputs...
ttBType = 'For NSE Sector, respective sector of NSE F&O script will be considered automatically'
defaultBType = input.string(defval='NIFTY50', title='Benchmark Type', group='Select Benchmark', options=['NIFTY50', 'NSE Sector', 'Custom Benchmark'], tooltip=ttBType)
ttBSymbol = 'To be used only when Benchmark Type is Custom Benchmark'
defaultBID = input.symbol('NSE:NIFTY', title='Comparative Symbol', group='Select Benchmark', tooltip=ttBSymbol)

source = input.source(title='Source', defval=close, group='Params')
ttLenRS = 'If Anchored RS is selected, this input will be ignored'
len = input.int(22, minval=1, title='Period-RS', tooltip=ttLenRS, group='Params')
lenMA = input.int(11, minval=1, title='Period-MA', group='Params')
zrTrendLookBack = input.int(5, minval=0, title='Lookback - Zero Line Trend', group='Params')
divLookBack = input.int(2, minval=0, title='Lookback - Divergence Dots', group='Params')

flagARS = input.bool(defval=false, title='Show Anchored RS (ARS)', group='Anchored RS')
historyDate = input.time(timestamp('2024-09-26 00:00'), 'Reference Date', group='Anchored RS')

flagMA = input.bool(defval=true, title='Display MA Line', group='Flags')
flagRSColor = input.bool(defval=true, title='Toggle RS Color on MA Crossovers', group='Flags')
flagZRTrend = input.bool(defval=true, title='Display Zero Line Trend', group='Flags')
flagDivDots = input.bool(defval=true, title='Display Divergence Dots', group='Flags')
flagFill = input.bool(defval=true, title='Display Filled Area', group='Flags')
flagSectorName = input.bool(defval=true, title='Display Sector Name', group='Flags')

colorZeroLine = input.color(color.new(color.gray, 0), 'Zero Line', group='COLORS')
colorRSPos = input.color(color.new(color.green, 0), 'RS Line - UP', group='COLORS')
colorRSNeg = input.color(color.new(color.red, 0), 'RS Line - DOWN', group='COLORS')
colorRSZero = input.color(color.new(color.purple, 0), 'RS Line', group='COLORS')
colorMALine = input.color(color.new(color.orange, 0), 'MA Line', group='COLORS')
colorDivPos = input.color(color.new(color.blue, 0), 'Divergence Dots - Positive', group='COLORS')
colorDivNeg = input.color(color.new(color.fuchsia, 0), 'Divergence Dots - Negative', group='COLORS')
colorText = input.color(color.new(color.blue, 0), 'Sector Name - F&O Script', group='COLORS')

// Get Sector... (all current NSE F&O underlyings from 14-Aug-2026 list)
var sectorMap = map.new<string, string>()

if bar_index == 0
    // --- NSE:CNXAUTO (17) ---
