    if on10
        array.push(aId, id10), array.push(aNm, nm10), array.push(aS, 10), array.push(aW, array.get(wts, 9))
        array.push(a0, rs0_10), array.push(a1, rs1_10), array.push(a2, rs2_10), array.push(aP, pct10)
        array.push(aC, c_10), array.push(aLine, v_10)
    if on11
        array.push(aId, id11), array.push(aNm, nm11), array.push(aS, 11), array.push(aW, array.get(wts, 10))
        array.push(a0, rs0_11), array.push(a1, rs1_11), array.push(a2, rs2_11), array.push(aP, pct11)
        array.push(aC, c_11), array.push(aLine, v_11)
    if on12
        array.push(aId, id12), array.push(aNm, nm12), array.push(aS, 12), array.push(aW, array.get(wts, 11))
        array.push(a0, rs0_12), array.push(a1, rs1_12), array.push(a2, rs2_12), array.push(aP, pct12)
        array.push(aC, c_12), array.push(aLine, v_12)
    if on13
        array.push(aId, id13), array.push(aNm, nm13), array.push(aS, 13), array.push(aW, array.get(wts, 12))
        array.push(a0, rs0_13), array.push(a1, rs1_13), array.push(a2, rs2_13), array.push(aP, pct13)
        array.push(aC, c_13), array.push(aLine, v_13)
    if on14
        array.push(aId, id14), array.push(aNm, nm14), array.push(aS, 14), array.push(aW, array.get(wts, 13))
        array.push(a0, rs0_14), array.push(a1, rs1_14), array.push(a2, rs2_14), array.push(aP, pct14)
        array.push(aC, c_14), array.push(aLine, v_14)
    if on15
        array.push(aId, id15), array.push(aNm, nm15), array.push(aS, 15), array.push(aW, array.get(wts, 14))
        array.push(a0, rs0_15), array.push(a1, rs1_15), array.push(a2, rs2_15), array.push(aP, pct15)
        array.push(aC, c_15), array.push(aLine, v_15)
    if on16
        array.push(aId, id16), array.push(aNm, nm16), array.push(aS, 16), array.push(aW, array.get(wts, 15))
        array.push(a0, rs0_16), array.push(a1, rs1_16), array.push(a2, rs2_16), array.push(aP, pct16)
        array.push(aC, c_16), array.push(aLine, v_16)
    if on17
        array.push(aId, id17), array.push(aNm, nm17), array.push(aS, 17), array.push(aW, array.get(wts, 16))
        array.push(a0, rs0_17), array.push(a1, rs1_17), array.push(a2, rs2_17), array.push(aP, pct17)
        array.push(aC, c_17), array.push(aLine, v_17)
    if on18
        array.push(aId, id18), array.push(aNm, nm18), array.push(aS, 18), array.push(aW, array.get(wts, 17))
        array.push(a0, rs0_18), array.push(a1, rs1_18), array.push(a2, rs2_18), array.push(aP, pct18)
        array.push(aC, c_18), array.push(aLine, v_18)
    if on19
        array.push(aId, id19), array.push(aNm, nm19), array.push(aS, 19), array.push(aW, array.get(wts, 18))
        array.push(a0, rs0_19), array.push(a1, rs1_19), array.push(a2, rs2_19), array.push(aP, pct19)
        array.push(aC, c_19), array.push(aLine, v_19)
    if on20
        array.push(aId, id20), array.push(aNm, nm20), array.push(aS, 20), array.push(aW, array.get(wts, 19))
        array.push(a0, rs0_20), array.push(a1, rs1_20), array.push(a2, rs2_20), array.push(aP, pct20)
        array.push(aC, c_20), array.push(aLine, v_20)

    int n = array.size(aNm)
    if n > 1
        for a = 0 to n - 2
            for b = 0 to n - 2 - a
                float left = rankBy == '%Change' ? array.get(aP, b) : array.get(a0, b)
                float right = rankBy == '%Change' ? array.get(aP, b + 1) : array.get(a0, b + 1)
                if nz(left) < nz(right)
                    swapStr(aId, b, b + 1)
                    swapStr(aNm, b, b + 1)
                    swapInt(aS, b, b + 1)
                    swapFlt(aW, b, b + 1)
                    swapFlt(a0, b, b + 1)
                    swapFlt(a1, b, b + 1)
                    swapFlt(a2, b, b + 1)
                    swapFlt(aP, b, b + 1)
                    swapClr(aC, b, b + 1)
                    swapFlt(aLine, b, b + 1)

    chartT = normTicker(syminfo.tickerid)
    float s0 = 0.0
    float s1 = 0.0
    float s2 = 0.0
    int ok0 = 0
    int ok1 = 0
    int ok2 = 0
    for i = 0 to n - 1
        row = i + 1
        nm = array.get(aNm, i)
        idv = array.get(aId, i)
        slotNum = array.get(aS, i)
        isMe = normTicker(idv) == chartT or nm == chartT
        isHl = slotNum == activeHighlightSlot
        slotCol = array.get(aC, i)
        v0 = array.get(a0, i)
        v1 = array.get(a1, i)
        v2 = array.get(a2, i)
        vp = array.get(aP, i)
        vw = array.get(aW, i)
        if not na(v0)
            s0 += v0
            ok0 += 1
        if not na(v1)
            s1 += v1
            ok1 += 1
        if not na(v2)
            s2 += v2
            ok2 += 1
        bg0 = rsShade(v0, v1, v2)
        bg1 = rsShade(v1, v0, v2)
        bg2 = rsShade(v2, v0, v1)
        bgP = na(vp) ? colBlank : vp >= 0 ? colUp : colDown
        bgR = color.from_gradient(row, 1, math.max(n, 2), colRankTop, colRankBot)

        string prefix = ''
        if isHl
            prefix := '⭐ '
        else if isMe
            prefix := '▶ '

        table.cell(tbl, 0, row, (row < 10 ? '0' : '') + str.tostring(row), text_color=textOn(bgR), bgcolor=bgR, text_size=txtSize)
        table.cell(tbl, 1, row, prefix + nm, text_color=textOn(slotCol), bgcolor=slotCol, text_size=txtSize)
        table.cell(tbl, 2, row, wstr(vw), text_color=color.white, bgcolor=color.new(#1a1a1a, 0), text_size=txtSize)
        table.cell(tbl, 3, row, fstr(v0), text_color=textOn(bg0), bgcolor=bg0, text_size=txtSize)
        table.cell(tbl, 4, row, fstr(v1), text_color=textOn(bg1), bgcolor=bg1, text_size=txtSize)
        table.cell(tbl, 5, row, fstr(v2), text_color=textOn(bg2), bgcolor=bg2, text_size=txtSize)
        table.cell(tbl, 6, row, fstr(vp), text_color=textOn(bgP), bgcolor=bgP, text_size=txtSize)

    avgRow = n + 1
    abg = color.new(#1b3d2f, 0)
    avg0 = ok0 > 0 ? s0 / ok0 : na
    avg1 = ok1 > 0 ? s1 / ok1 : na
    avg2 = ok2 > 0 ? s2 / ok2 : na
    abg0 = rsShade(avg0, avg1, avg2)
    abg1 = rsShade(avg1, avg0, avg2)
    abg2 = rsShade(avg2, avg0, avg1)
    table.cell(tbl, 0, avgRow, '---', text_color=color.white, bgcolor=abg, text_size=txtSize)
    table.cell(tbl, 1, avgRow, 'Average', text_color=color.white, bgcolor=abg, text_size=txtSize)
    table.cell(tbl, 2, avgRow, '---', text_color=color.white, bgcolor=abg, text_size=txtSize)
    table.cell(tbl, 3, avgRow, fstr(avg0), text_color=textOn(abg0), bgcolor=abg0, text_size=txtSize)
    table.cell(tbl, 4, avgRow, fstr(avg1), text_color=textOn(abg1), bgcolor=abg1, text_size=txtSize)
    table.cell(tbl, 5, avgRow, fstr(avg2), text_color=textOn(abg2), bgcolor=abg2, text_size=txtSize)
    table.cell(tbl, 6, avgRow, '---', text_color=color.white, bgcolor=abg, text_size=txtSize)

    string titleBench = defaultBType == 'Auto Sector' ? finalBenchTicker : customBench
    table.cell(foot, 0, 0, 'Benchmark = ' + titleBench, text_color=color.white, text_size=txtSize)
