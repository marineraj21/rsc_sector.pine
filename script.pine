//@version=6
indicator("Trend AI plus", overlay=true, max_boxes_count=500)

// === TYPES ===
type Gap
    bool isActive
    bool isBull
    array<box> boxes

type AlertInfo
    int countOpenGap
    int countClosedGap

// === INPUTS ===
// --- Volume Settings ---
string groupVol = "Volume Settings"
lowVolLookback = input.int(100, title="Rolling Low Volume Lookback (Days)", minval=1, group=groupVol)
highVolYears = input.int(5, title="Rolling High Volume Years", minval=1, group=groupVol)
lowVolColor = input.color(color.yellow, title="Rolling Low Volume Color", group=groupVol)
rollingHighColor = input.color(color.blue, title="5-Year High Volume Color", group=groupVol)
allTimeHighColor = input.color(color.green, title="All-Time High Volume Color", group=groupVol)

// --- Gap Settings ---
string groupGaps = "Gap Settings"
closeGapsPartially = input.bool(false, "Close Gaps Partially", group=groupGaps)
boxLimitInput = input.int(15, "Max Number of Gaps", minval=1, maxval=500, group=groupGaps)
minimalDeviationTooltip = "Specifies the minimal size of detected gaps, as a percentage of the average high-low range for the last 14 bars."
minimalDeviationInput = nz(input.float(30.0, "Minimal Deviation (%)", tooltip=minimalDeviationTooltip, minval=1, maxval=100, group=groupGaps) / 100 * ta.sma(high-low, 14))
limitBoxLengthBoolInput = input.bool(false, "Limit Max Gap Trail Length (bars)", inline="Length Limit", group=groupGaps)
limitBoxLengthIntInput = input.int(300, "", inline="Length Limit", minval=1, group=groupGaps)

string groupGapColors = "Gap Border and fill colors"
colorUpBorderInput = input.color(color.green, "Up Gaps", inline="Gap Up", group=groupGaps)
colorUpBackgroundInput = input.color(color.new(color.green, 85), "", inline="Gap Up", group=groupGaps)
colorDownBorderInput = input.color(color.red, "Down Gaps", inline="Gap Down", group=groupGaps)
colorDownBackgroundInput = input.color(color.new(color.red, 85), "", inline="Gap Down", group=groupGaps)

// --- Lines Settings ---
var grp_lines = "Lines Settings"
line1_type = input.string("EMA", "Line 1 Type", options=["EMA", "SMA"], group=grp_lines)
line1_len = input.int(34, "Line 1 Length", group=grp_lines)

line2_len = input.int(5, "Line 2 (EMA) Length", group=grp_lines)

line3_type = input.string("SMA", "Line 3 Type", options=["EMA", "SMA"], group=grp_lines)
line3_len = input.int(50, "Line 3 Length", group=grp_lines)

// --- Supertrend Settings ---
var grp_st = "Supertrend Settings"
st_factor = input.float(3.0, "Supertrend Factor", group=grp_st)
st_atr = input.int(10, "Supertrend ATR Period", group=grp_st)

// --- ADX Settings ---
var grp_adx = "ADX Settings"
adx_tf = input.timeframe("D", "ADX Timeframe", options=["D", "W"], group=grp_adx)
adx_len = input.int(14, "ADX Length", group=grp_adx)


// === SCRIPT VARIABLES ===
// --- Volume Variables ---
var float allTimeHighestVol = 0.0
var int allTimeHighestVolIndex = 0
var label lowVolLabel = na

// --- Gap Variables ---
var allGaps = array.new<Gap>()
var AlertInfo alertInfo = AlertInfo.new(0, 0)
var bool newGapAlert = false
var bool closedGapAlert = false

// --- Highest Price Change Variables ---
var label high_change_label = na


// === METHODS & FUNCTIONS ===
method delete(Gap this) =>
    for _box in this.boxes
        _box.delete()

method partialClose(Gap this) =>
    activeBox = this.boxes.last()
    activeBox.set_extend(extend.none)
    top = this.isBull ? activeBox.get_top() : low
    bottom = this.isBull ? high : activeBox.get_bottom()
    this.boxes.push(box.new(bar_index,top,bar_index,bottom, this.isBull ? colorDownBorderInput : colorUpBorderInput, bgcolor = this.isBull ? colorDownBackgroundInput : colorUpBackgroundInput))

method fullClose(Gap this) =>
    activeBox = this.boxes.last()
    activeBox.set_extend(extend.none)
    this.isActive := false
    if closeGapsPartially
        activeBox.delete()
    alertInfo.countClosedGap += 1

method checkForClose(Gap this) =>
    if this.isActive
        activeBox = this.boxes.last()
        top = activeBox.get_top()
        bot = activeBox.get_bottom()
        isBull = this.isBull
        activeBox.set_right(bar_index)
        if (high > bot and isBull) or (low < top and not isBull)
            if closeGapsPartially
                this.partialClose()
            else
                this.fullClose()
        bool forceCloseBoxExceededLengthLimit = (limitBoxLengthBoolInput and bar_index - activeBox.get_left() >= limitBoxLengthIntInput)
        if ((high > top and isBull) or (low < bot and not isBull)) or forceCloseBoxExceededLengthLimit
            this.fullClose()

method hasOpenedGap(AlertInfo this) =>
    this.countOpenGap > 0

method hasClosedGap(AlertInfo this) =>
    this.countClosedGap > 0

registerNewGap(isGapDown, boxBorderColor, boxBgcolor) =>
    newBox = box.new(bar_index - 1, (isGapDown ? low[1] : low), bar_index, (isGapDown ? high : high[1]), border_color=boxBorderColor, bgcolor=boxBgcolor, extend=extend.right)
    allGaps.push(Gap.new(true, isGapDown, array.from(newBox)))
    if allGaps.size() > boxLimitInput
        allGaps.shift().delete()

calc_ma(type, len, src) =>
    type == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

calc_adx(len) =>
    [plus, minus] = dirmov(len)
    sum = plus + minus
    adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), len)
    adx

f_find_highest_in_last_90_days() =>
    highest_c = 0.0
    highest_c_index_offset = 0
    for i = 0 to 89
        if i < bar_index
            change_i = (high[i] - low[i]) / low[i] * 100
            if change_i > highest_c
                highest_c := change_i
                highest_c_index_offset := i
    [time[highest_c_index_offset], high[highest_c_index_offset], highest_c]


// === CORE LOGIC ===

// Visual flags (last 100 candles and last 50 candles)
show_signals = last_bar_index - bar_index <= 100
show_lines = last_bar_index - bar_index <= 50

// --- Volume Calculations ---
// Rolling Low Volume (Daily Timeframe Only)
isLowestVolume = if timeframe.isdaily
    lowestVolume = ta.lowest(volume, lowVolLookback)
    volume == lowestVolume and bar_index > lowVolLookback
else
    false

if isLowestVolume and show_signals
    if not na(lowVolLabel)
        label.delete(lowVolLabel)
    lowVolLabel := label.new(bar_index, na, text='●', yloc=yloc.belowbar, color=color.new(color.white, 100), textcolor=lowVolColor, style=label.style_none, size=size.small)

daysInYear = 252
rollingLookback = highVolYears * daysInYear
rollingHighestVol = ta.highest(volume, rollingLookback)
isRollingHigh = volume == rollingHighestVol and bar_index > rollingLookback

if volume > allTimeHighestVol
    allTimeHighestVol := volume
    allTimeHighestVolIndex := bar_index
isAllTimeHigh = bar_index == allTimeHighestVolIndex


// --- Gap Logic (Daily Timeframe Only) ---
if timeframe.isdaily
    isGapDown = high < low[1] and low[1] - high >= minimalDeviationInput
    isGapUp = low > high[1] and low - high[1] >= minimalDeviationInput
    isGap = isGapDown or isGapUp
    boxBorderColor = isGapDown ? colorDownBorderInput : colorUpBorderInput
    boxBgcolor = isGapDown ? colorDownBackgroundInput : colorUpBackgroundInput

    alertInfo.countOpenGap := 0
    alertInfo.countClosedGap := 0

    for gap in allGaps
        gap.checkForClose()

    if isGap and show_signals // Only register visual gap on last 100 candles
        registerNewGap(isGapDown, boxBorderColor, boxBgcolor)
        alertInfo.countOpenGap += 1

    if barstate.islastconfirmedhistory and allGaps.size() == 0
        noGapText = "No gaps found on the current chart.\nThe cause could be that some exchanges align the open of new bars on the close of the previous one, resulting in charts with no gaps. Alternatively, your Minimal Deviation might be too high."
        var infoTable = table.new(position.bottom_right, 1, 1)
        table.cell(infoTable, 0, 0, text=noGapText, text_color=color.gray, bgcolor=color.new(color.gray, 80))

    newGapAlert := alertInfo.hasOpenedGap()
    closedGapAlert := alertInfo.hasClosedGap()
else
    newGapAlert := false
    closedGapAlert := false


// --- Line Calculations ---
ma1 = calc_ma(line1_type, line1_len, close)
ema5 = ta.ema(close, line2_len)
ma3 = calc_ma(line3_type, line3_len, close)

// EMA 5 Color Logic
ema5_high4 = ta.highest(ema5, 4)[1]
ema5_low4 = ta.lowest(ema5, 4)[1]

var color ema5_color = color.white

if ema5 > ema5_high4
    ema5_color := color.green
else if ema5 < ema5_low4
    ema5_color := color.red
else
    ema5_color := color.white

// --- Supertrend ---
[supertrend, direction] = ta.supertrend(st_factor, st_atr)
st_cross_up = ta.crossover(close, supertrend)
st_cross_down = ta.crossunder(close, supertrend)


// --- ADX Logic ---
local_adx = calc_adx(adx_len)
htf_adx = request.security(syminfo.tickerid, adx_tf, local_adx)

adx_was_below_10 = htf_adx[1] < 10
adx_is_above_10 = htf_adx >= 10
adx_signal = adx_was_below_10 and adx_is_above_10


// --- SMA Cluster Logic ---
sma13 = ta.sma(close, 13)
sma30 = ta.sma(close, 30)
sma50 = ta.sma(close, 50)
sma100 = ta.sma(close, 100)
sma150 = ta.sma(close, 150)
sma200 = ta.sma(close, 200)

highest_sma = math.max(sma13, sma30, sma50, sma100, sma150, sma200)
lowest_sma = math.min(sma13, sma30, sma50, sma100, sma150, sma200)

cluster = (highest_sma - lowest_sma) / lowest_sma <= 0.02


// --- Highest Price Change Logic ---
if barstate.islast
    [t, h, c] = request.security(syminfo.tickerid, "D", f_find_highest_in_last_90_days(), lookahead=barmerge.lookahead_on)
    if not na(t)
        if not na(high_change_label)
            label.set_xy(high_change_label, t, h)
            label.set_text(high_change_label, str.tostring(c, '#.##') + '%')
        else
            high_change_label := label.new(x=t, y=h, text=str.tostring(c, '#.##') + '%', xloc=xloc.bar_time, color=color.yellow, textcolor=color.black, style=label.style_label_down)


// === PLOTTING & ALERTS ===

// Lines (Last 50 candles)
plot(show_lines ? ma1 : na, color=color.blue, title="Line 1")
plot(show_lines ? ema5 : na, color=ema5_color, linewidth=3, title="Line 2 (EMA 5)")
plot(show_lines ? ma3 : na, color=color.orange, title="Line 3")

// Shapes (Last 100 candles)
plotshape(show_signals and isRollingHigh ? high : na, "5-Year High Volume", style=shape.circle, location=location.absolute, color=rollingHighColor, size=size.small)
plotshape(show_signals and isAllTimeHigh, "All-Time High Volume", style=shape.triangleup, location=location.abovebar, color=allTimeHighColor, size=size.small)

plotshape(show_signals and st_cross_up, title="Supertrend Cross Up", style=shape.arrowup, location=location.belowbar, color=color.green, size=size.small)
plotshape(show_signals and st_cross_down, title="Supertrend Cross Down", style=shape.arrowdown, location=location.abovebar, color=color.red, size=size.small)

plotshape(show_signals and adx_signal, title="ADX Signal", style=shape.triangleup, location=location.belowbar, color=color.yellow, size=size.normal)

plotshape(show_signals and cluster, title="SMA Cluster", style=shape.circle, location=location.abovebar, color=color.aqua, size=size.small)

// Alerts
alertcondition(newGapAlert, "New Gap Appeared", "A new gap has appeared.")
alertcondition(closedGapAlert, "Gap Closed", "A gap has been closed.")

//_____________________________ CODE END